# Secrets — never commit these
.env
.env.*
!.env.example

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp

# Python (for later; ignore cache and virtual environments)
__pycache__/
*.py[cod]
.venv/
venv/
.env/

# Logs and temp files
*.log
tmp/
temp/

# Local conversation history (private; do not commit)
data/current_session.json
data/.current_session.json.*.tmp

# Local SQLite data, sidecars, backups, and recovery work files
data/*.sqlite3*
data/*-wal
data/*-shm
data/backups/
data/.backup-*
data/.restore-*
data/.migration-rehearsal-*

# Personal context (local-only; do not commit)
/docs/goals.md
/docs/memory.md
